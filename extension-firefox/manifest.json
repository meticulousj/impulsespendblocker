{
  "manifest_version": 3,
  "name": "Impulse Spend Blocker",
  "version": "1.2.0",
  "description": "Pops up a BUY / WAIT / SKIP check automatically when you're on a product or checkout page.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.es/*",
    "https://*.amazon.it/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.com.au/*",
    "https://*.myshopify.com/*",
    "https://*.shopify.com/*",
    "https://*.ebay.com/*",
    "https://*.etsy.com/*",
    "https://*.target.com/*",
    "https://*.bestbuy.com/*",
    "https://*.walmart.com/*",
    "https://impulsespendblocker.lovable.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.es/*",
        "https://*.amazon.it/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.com.au/*",
        "https://*.myshopify.com/*",
        "https://*.shopify.com/*",
        "https://*.ebay.com/*",
        "https://*.etsy.com/*",
        "https://*.target.com/*",
        "https://*.bestbuy.com/*",
        "https://*.walmart.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://impulsespendblocker.lovable.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "impulse-spend-blocker@lovable.app",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}